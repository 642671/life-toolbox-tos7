[zh-cn]
name = "生活工具箱"
auth = "qishiyi"
descript = "离线生活计算工具箱，包含日期、单位换算、BMI、折扣、小费、油耗、贷款、随机选择和密码生成。"
release_note = "1.0.009：修复“页面说后端服务未运行、其实是请求被浏览器或平台拦下”的误报。横幅现在按四类成因分别说明并给出对应处置——网络层被拦、TOS 会话未生效、平台代理没有转到本应用、后端确实返回错误，同时显示实际失败的请求地址。前端会探测规范允许的多个代理路径，并复用第一个真正回到本应用的地址；无体 GET 不再携带 Content-Type，也不再手写浏览器禁止的 Cookie 头；后端只在请求确实带 Origin 时回显跨源响应头并附 Vary: Origin。"
important = "BMI 和贷款结果仅供日常参考，不构成医疗或金融建议。"

[zh-hk]
name = "生活工具箱"
auth = "qishiyi"
descript = "離線生活計算工具箱，包含日期、單位換算、BMI、折扣、小費、油耗、貸款、隨機選擇和密碼產生。"
release_note = "1.0.009：修復「頁面說後端服務未運行、其實是請求被瀏覽器或平台攔下」的誤報。橫幅現在按四類成因分別說明並給出對應處置——網路層被攔、TOS 工作階段未生效、平台代理沒有轉到本應用、後端確實返回錯誤，同時顯示實際失敗的請求位址。前端會探測規範允許的多個代理路徑，並重複使用第一個真正回到本应用的位址；無主體 GET 不再攜帶 Content-Type，也不再手寫瀏覽器禁止的 Cookie 頭；後端只在請求確實帶 Origin 時回顯跨源回應標頭並附 Vary: Origin。"
important = "BMI 和貸款結果僅供日常參考，不構成醫療或金融建議。"

[en-us]
name = "Life Toolbox"
auth = "qishiyi"
descript = "Offline daily utility toolbox with date, unit, BMI, discount, tip, fuel, loan, picker, and password tools."
release_note = "1.0.009: fixes the false alarm where the page blamed a dead backend for a request the browser or the platform never forwarded. The banner now separates four causes and gives the matching remedy - blocked at the network layer, no valid TOS session, the platform proxy not reaching this app, and a genuine backend error - and it shows the exact URL that failed. The frontend probes the proxy paths the spec allows and reuses the first one that actually answers as this app; bodyless GETs no longer send Content-Type and no longer hand-write the Cookie header browsers forbid; the backend echoes CORS headers only when the request really carries an Origin, and adds Vary: Origin."
important = "BMI and loan results are general estimates, not medical or financial advice."

[fr-fr]
name = "Boite a outils"
auth = "qishiyi"
descript = "Boite a outils hors ligne avec calculateurs de date, unites, IMC, remises, pourboires, carburant, prets, choix et mots de passe."
release_note = "1.0.009 : corrige la fausse alerte qui accusait le backend d'être mort alors que la requête n'avait jamais été transmise. La bannière distingue désormais quatre causes avec le remède correspondant - bloqué au niveau réseau, session TOS absente, proxy de la plateforme n'atteignant pas cette application, véritable erreur du backend - et affiche l'URL exacte en échec. Le frontend teste les chemins de proxy autorisés par la spécification et réutilise le premier qui répond vraiment en tant que cette application ; les GET sans corps n'envoient plus Content-Type ni l'en-tête Cookie interdit par les navigateurs ; le backend ne renvoie les en-têtes CORS que si la requête porte un Origin, et ajoute Vary: Origin."
important = "Les resultats IMC et pret sont indicatifs et ne constituent pas un avis medical ou financier."

[de-de]
name = "Alltags-Werkzeugkasten"
auth = "qishiyi"
descript = "Offline-Werkzeugkasten mit Rechnern fuer Datum, Einheiten, BMI, Rabatt, Trinkgeld, Kraftstoff, Kredit, Auswahl und Passwort."
release_note = "1.0.009: behebt die Fehlalarm-Meldung, die einen toten Backend-Dienst für eine Anfrage verantwortlich machte, die der Browser oder die Plattform nie weitergeleitet hat. Das Banner unterscheidet jetzt vier Ursachen samt passender Abhilfe - auf Netzwerkebene blockiert, keine gültige TOS-Sitzung, der Plattform-Proxy erreicht diese App nicht, echter Backend-Fehler - und zeigt die exakte fehlgeschlagene URL. Das Frontend prüft die von der Spezifikation erlaubten Proxy-Pfade und verwendet den ersten weiter, der wirklich als diese App antwortet; GETs ohne Body senden kein Content-Type mehr und schreiben das von Browsern verbotene Cookie-Header nicht mehr manuell; das Backend gibt CORS-Header nur zurück, wenn die Anfrage ein Origin enthält, und ergänzt Vary: Origin."
important = "BMI- und Kreditwerte sind nur allgemeine Schaetzungen, keine medizinische oder finanzielle Beratung."

[it-it]
name = "Cassetta degli attrezzi"
auth = "qishiyi"
descript = "Cassetta degli attrezzi offline con calcolatori per date, unita, BMI, sconti, mance, carburante, prestiti, scelte e password."
release_note = "1.0.009: corregge il falso allarme che incolpava un backend morto per una richiesta mai inoltrata dal browser o dalla piattaforma. Il banner ora distingue quattro cause con il rimedio corrispondente - blocco a livello di rete, assenza di sessione TOS, proxy della piattaforma che non raggiunge questa app, errore reale del backend - e mostra l'URL esatto non riuscito. Il frontend verifica i percorsi proxy consentiti dalla specifica e riutilizza il primo che risponde davvero come questa app; le GET senza corpo non inviano più Content-Type e non scrivono più manualmente l'header Cookie vietato dai browser; il backend fa eco agli header CORS solo se la richiesta contiene un Origin e aggiunge Vary: Origin."
important = "I risultati BMI e prestito sono stime generali, non consulenza medica o finanziaria."

[es-es]
name = "Caja de herramientas"
auth = "qishiyi"
descript = "Caja de herramientas sin conexion con calculadoras de fecha, unidades, IMC, descuentos, propinas, combustible, prestamos, eleccion y contrasenas."
release_note = "1.0.009: corrige la falsa alarma que culpaba a un backend caído de una petición que el navegador o la plataforma nunca reenviaron. El aviso ahora distingue cuatro causas con su remedio correspondiente - bloqueo en la capa de red, sesión TOS ausente, proxy de la plataforma que no llega a esta aplicación y error real del backend - y muestra la URL exacta que falló. El frontend prueba las rutas de proxy que permite la especificación y reutiliza la primera que responde de verdad como esta aplicación; los GET sin cuerpo ya no envían Content-Type ni escriben a mano la cabecera Cookie que prohíben los navegadores; el backend devuelve las cabeceras CORS solo si la petición lleva Origin y añade Vary: Origin."
important = "Los resultados de IMC y prestamos son estimaciones generales, no asesoramiento medico o financiero."

[hu-hu]
name = "Eletmod eszkozkeszlet"
auth = "qishiyi"
descript = "Offline eszkozkeszlet datum, egyseg, BMI, kedvezmeny, borravalo, uzemanyag, hitel, valaszto es jelszo szamitasokhoz."
release_note = "1.0.009: megszünteti azt a téves riasztást, amely olyan kérésért tette felelőssé a nem futó hátulrendszert, amelyet a böngésző vagy a platform soha nem továbbított. A sáv most négy okot és a hozzájuk tartozó teendőt különíti el - hálózati szintű blokkolás, érvénytelen TOS munkamenet, az alkalmazást el nem érő platform-proxy, valódi háttérhiba - és mutatja a ténylegesen megbukott URL-t. A frontend végigpróbálja a szabvány által engedélyezett proxy útvonalakat, és azt használja tovább, amelyik tényleg ezzel az alkalmazással válaszol; a törzs nélküli GET kérések nem küldenek Content-Type fejlécet, és a böngészők által tiltott Cookie fejlécet sem írják kézzel; a backend csak akkor ad vissza CORS fejléceket, ha a kérés tényleg tartalmaz Origint, és Vary: Origin mezőt is tesz hozzá."
important = "A BMI es hitel eredmenyek altalanos becslesek, nem orvosi vagy penzugyi tanacsok."

[ja-jp]
name = "生活ツールボックス"
auth = "qishiyi"
descript = "日付、単位、BMI、割引、チップ、燃料、ローン、ランダム選択、パスワード生成を含むオフラインツールです。"
release_note = "1.0.009：ブラウザまたはプラットフォームが実際には転送しなかった要求を「バックエンドが動いていない」と誤表示する問題を修正しました。バナーは 4 つの原因と対処を分けて表示します——ネットワーク層で遮断、TOS セッション未有効、プラットフォームプロキシが本アプリに到達しない、バックエンドが実際にエラーを返した——そして失敗した正確な URL を表示します。フロントエンドは仕様が認めるプロキシ経路を順に確認し、本アプリとして応答したものを以後利用します。本文のない GET は Content-Type を送らず、ブラウザが禁止する Cookie ヘッダーも手書きしません。バックエンドは要求に Origin が実際にある場合のみ CORS ヘッダーを返し、Vary: Origin を追加します。"
important = "BMI とローンの結果は一般的な目安であり、医療または金融アドバイスではありません。"

[ko-kr]
name = "생활 도구함"
auth = "qishiyi"
descript = "날짜, 단위, BMI, 할인, 팁, 연료, 대출, 무작위 선택, 비밀번호 도구를 포함한 오프라인 도구함입니다."
release_note = "1.0.009: 브라우저 또는 플랫폼이 실제로 전달하지 않은 요청을 '백엔드가 실행되지 않음'으로 오보하던 문제를 수정했습니다. 배너는 네 가지 원인과 조치를 구분하여 표시합니다 — 네트워크 계층 차단, TOS 세션 미유효, 플랫폼 프록시가 본 앱에 도달하지 않음, 백엔드가 실제로 오류를 반환한 경우 — 그리고 실패한 정확한 URL을 표시합니다. 프론트엔드는 명세가 허용하는 프록시 경로를 순서대로 탐색하여 본 앱으로 응답한 첫 경로를 이후에 재사용합니다. 본문이 없는 GET은 Content-Type을 보내지 않고, 브라우저가 금지하는 Cookie 헤더도 직접 작성하지 않습니다. 백엔드는 요청에 Origin이 실제로 있을 때만 CORS 헤더를 반사하고 Vary: Origin을 추가합니다."
important = "BMI와 대출 결과는 일반적인 추정치이며 의료 또는 금융 조언이 아닙니다."

[pl-pl]
name = "Skrzynka narzedzi"
auth = "qishiyi"
descript = "Narzedzia offline do dat, jednostek, BMI, rabatow, napiwkow, paliwa, kredytow, losowania i hasel."
release_note = "1.0.009: usuwa fałszywy alarm, w którym strona obwiniała martwy backend za żądanie, którego przeglądarka ani platforma nigdy nie przekazały. Baner rozróżnia teraz cztery przyczyny wraz z odpowiednim działaniem - zablokowanie na warstwie sieciowej, brak ważnej sesji TOS, proxy platformy nie trafia do tej aplikacji, rzeczywisty błąd backendu - i pokazuje dokładny adres URL, który zawiódł. Frontend sprawdza ścieżki proxy dopuszczone przez specyfikację i używa dalej tej, która naprawdę odpowiada jako ta aplikacja; GET bez treści nie wysyła Content-Type ani nie dopisuje ręcznie nagłówka Cookie, którego przeglądarki zabraniają; backend zwraca nagłówki CORS tylko gdy żądanie naprawdę niesie Origin i dodaje Vary: Origin."
important = "Wyniki BMI i kredytu sa ogolnymi szacunkami, a nie porada medyczna lub finansowa."

[ru-ru]
name = "Zhiznennyj nabor"
auth = "qishiyi"
descript = "Oflajn-instrumenty dlya dat, edinic, IMT, skidok, chaevyh, topliva, kreditov, vybora i parolya."
release_note = "1.0.009: устраняет ложную тревогу, при которой страница винила неработающий бэкенд в запросе, который браузер или платформа никогда не передавали. Баннер теперь разделяет четыре причины с соответствующими действиями — блокировка на сетевом уровне, недействительная сессия TOS, прокси платформы не дошёл до этого приложения, реальная ошибка бэкенда, — и показывает точный неудавшийся URL. Фронтенд перебирает прокси-пути, разрешённые спецификацией, и дальше использует тот, что действительно отвечает как это приложение; GET без тела больше не отправляет Content-Type и не прописывает вручную заголовок Cookie, запрещённый браузерами; бэкенд возвращает CORS-заголовки, только если запрос действительно несёт Origin, и добавляет Vary: Origin."
important = "Rezultaty IMT i kredita yavlyayutsya obshchimi ocenkami, a ne medicinskim ili finansovym sovetom."

[tr-tr]
name = "Yasam Arac Kutusu"
auth = "qishiyi"
descript = "Tarih, birim, BMI, indirim, bahsis, yakit, kredi, secim ve parola araclari iceren cevrimdisi arac kutusu."
release_note = "1.0.009: tarayıcının veya platformun hiç iletmediği bir istek için sayfanın arka ucu çökmüş gibi göstermesi düzeltildi. Ayrış şimdi dört nedeni ve karşılığındaki işlemi ayırıyor — ağ katmanında engellendi, geçerli TOS oturumu yok, platform vekili bu uygulamaya ulaşmadı, gerçek arka uç hatası — ve başarısız olan tam adresi gösteriyor. Ön uç, yönetmeliğin izin verdiği vekil yollarını sırayla dener ve gerçekten bu uygulama olarak yanıt veren ilkini sonraki çağrılarda yeniden kullanır; gövdesiz GET artık Content-Type göndermez ve tarayıcıların yasakladığı Cookie başlığını elle yazmaz. Arka uç, CORS başlıklarını yalnızca istek gerçekten bir Origin taşıyorsa yansıtır ve Vary: Origin ekler."
important = "BMI ve kredi sonuclari genel tahminlerdir; tibbi veya finansal tavsiye degildir."

[pt-pt]
name = "Caixa de ferramentas"
auth = "qishiyi"
descript = "Caixa de ferramentas offline com data, unidades, IMC, descontos, gorjetas, combustivel, emprestimos, escolha e palavras-passe."
release_note = "1.0.009: corrige o falso alarme em que a página culpava um backend inactivo por um pedido que o navegador ou a plataforma nunca encaminharam. O aviso distingue agora quatro causas com a respetiva correção - bloqueado à camada de rede, sessão TOS inválida, o proxy da plataforma não chega a esta aplicação e erro real do backend - e mostra o URL exato que falhou. O frontend testa os caminhos de proxy permitidos pela especificação e reutiliza o primeiro que realmente responde como esta aplicação; GETs sem corpo deixam de enviar Content-Type e de escrever manualmente o cabeçalho Cookie que os navegadores proíbem; o backend devolve cabeçalhos CORS apenas quando o pedido realmente leva Origin e acrescenta Vary: Origin."
important = "Os resultados de IMC e emprestimo sao estimativas gerais, nao aconselhamento medico ou financeiro."
